# StrataKB settings. This file is not read automatically.
# Copy it to the user-level config.env and adjust:
#   Windows:   %APPDATA%\stratakb\config.env
#   elsewhere: $XDG_CONFIG_HOME/stratakb/config.env, else ~/.config/stratakb/config.env
# For development, copy it to .env and set STRATAKB_CONFIG=.env.
# docker compose still reads ./.env itself, for DB_PASSWORD, DB_PORT and
# READONLY_DB_PASSWORD; the server ignores those keys.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://strata:strata_dev_password@localhost:5433/strata
DB_PASSWORD=strata_dev_password
DB_PORT=5433

# Read-only role for strata_db_query and strata_db_explain (created by db/03_readonly_role.sql).
# Without READONLY_DATABASE_URL these two tools are not available; a superuser, a member of a
# superuser or server-access role, or a role that can't be checked is refused.
READONLY_DATABASE_URL=postgresql://strata_readonly:strata_readonly_dev_password@localhost:5433/strata
READONLY_DB_PASSWORD=strata_readonly_dev_password

# Identity on the stdio transport: who you are and which role you act as
# (viewer, operator or admin)
STRATA_USER=developer
STRATA_ROLE=admin

# Embeddings: "local" (sentence-transformers, no key needed) or "openai"
# ("openai": OpenAI, or any OpenAI-compatible server through EMBEDDING_BASE_URL)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768
# OPENAI_API_KEY=sk-...

# Embeddings from a local Ollama server instead (no OpenAI key needed):
# EMBEDDING_BACKEND=openai
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# Only needed when the server asks for a key; OPENAI_API_KEY is never sent there.
# EMBEDDING_API_KEY=

# Optional: LLM query rewriting in strata_ask. Without a key, questions are searched as written.
# ANTHROPIC_API_KEY=sk-ant-...

# Query rewriting through a local Ollama server instead (no Anthropic key needed):
# QUERY_REWRITE_PROVIDER=openai_compatible
# QUERY_REWRITE_BASE_URL=http://127.0.0.1:11434/v1
# QUERY_REWRITE_MODEL=llama3.2
# Only needed when the server asks for a key; OPENAI_API_KEY is never sent there.
# QUERY_REWRITE_API_KEY=

# Refuse to start while any setting would send content off this machine, and load models from local files only
# STRATA_LOCAL_ONLY=true

# Logging (logs go to stderr)
LOG_LEVEL=INFO
