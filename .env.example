# StrataKB environment variables. Copy to .env and adjust.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://strata:strata_dev_password@localhost:5433/strata
DB_PASSWORD=strata_dev_password
DB_PORT=5433

# Read-only role for strata_db_query and strata_db_explain (created by db/03_readonly_role.sql).
# Without READONLY_DATABASE_URL these two tools are not available; a superuser role is refused.
READONLY_DATABASE_URL=postgresql://strata_readonly:strata_readonly_dev_password@localhost:5433/strata
READONLY_DB_PASSWORD=strata_readonly_dev_password

# Identity on the stdio transport: who you are and which role you act as
# (viewer, operator or admin)
STRATA_USER=developer
STRATA_ROLE=admin

# Embeddings: "local" (sentence-transformers, no key needed) or "openai"
# ("openai": OpenAI, or any OpenAI-compatible server through EMBEDDING_BASE_URL)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768
# OPENAI_API_KEY=sk-...

# Embeddings from a local Ollama server instead (no OpenAI key needed):
# EMBEDDING_BACKEND=openai
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# Only needed when the server asks for a key; OPENAI_API_KEY is never sent there.
# EMBEDDING_API_KEY=

# Optional: LLM query rewriting in strata_ask. Without a key, questions are searched as written.
# ANTHROPIC_API_KEY=sk-ant-...

# Logging (logs go to stderr)
LOG_LEVEL=INFO
